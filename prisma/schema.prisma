generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id             String                 @id @default(cuid())
  email          String                 @unique
  passwordHash   String
  firstName      String
  lastName       String
  phone          String?
  avatarUrl      String?
  role           UserRole               @default(STUDENT)
  status         UserStatus             @default(ACTIVE)
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt
  lastLoginAt    DateTime?
  announcements  Announcement[]
  applications   Application[]
  attendances    Attendance[]
  cohorts        Cohort[]               @relation("CohortCreatedBy")
  enrollments    Enrollment[]
  gradedBy       Grade[]                @relation("GradeGradedBy")
  grades         Grade[]                @relation("GradeStudent")
  liveClasses    LiveClass[]            @relation("LiveClassCreatedBy")
  payments       Payment[]
  achievements   StudentAchievement[]
  activities     StudentActivity[]
  studentProfile StudentProfile?
  projects       StudentProjectRecord[]
  attempts       TestAttempt[]
}

model StudentProfile {
  id               String    @id @default(cuid())
  userId           String    @unique
  dateOfBirth      DateTime?
  educationalLevel String?
  address          String?
  emergencyContact String?
  emergencyPhone   String?
  studentNumber    String    @unique
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Application {
  id                 String            @id @default(cuid())
  applicantId        String?
  fullName           String
  email              String
  phone              String
  dateOfBirth        DateTime?
  educationalLevel   String?
  courseId           String?
  preferredFormat    String?
  preferredStartDate DateTime?
  additionalInfo     String?
  status             ApplicationStatus @default(PENDING)
  adminNotes         String?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  applicant          User?             @relation(fields: [applicantId], references: [id])
  course             Course?           @relation(fields: [courseId], references: [id])

  @@index([status])
  @@index([courseId])
  @@index([createdAt])
}

model Course {
  id               String         @id @default(cuid())
  title            String
  slug             String         @unique
  shortDescription String
  description      String?
  imageUrl         String?
  duration         String?
  learningFormat   String?
  requirements     String?
  syllabus         String?
  status           CourseStatus   @default(DRAFT)
  featured         Boolean        @default(false)
  displayOrder     Int            @default(0)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  applications     Application[]
  assessments      Assessment[]
  cohorts          Cohort[]
  modules          CourseModule[]
  enrollments      Enrollment[]
  liveClasses      LiveClass[]
  tests            Test[]

  @@index([status])
  @@index([featured])
  @@index([displayOrder])
}

model CourseModule {
  id           String   @id @default(cuid())
  courseId     String
  title        String
  description  String?
  displayOrder Int      @default(0)
  isPublished  Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  course       Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessons      Lesson[]

  @@index([courseId])
  @@index([displayOrder])
}

model Lesson {
  id           String           @id @default(cuid())
  moduleId     String
  title        String
  slug         String
  description  String?
  content      String?
  videoUrl     String?
  duration     Int?
  displayOrder Int              @default(0)
  isPublished  Boolean          @default(false)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  module       CourseModule     @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  progress     LessonProgress[]

  @@unique([moduleId, slug])
  @@index([moduleId])
  @@index([displayOrder])
  @@index([isPublished])
}

model Enrollment {
  id             String                @id @default(cuid())
  studentId      String
  courseId       String
  status         EnrollmentStatus      @default(ACTIVE)
  progress       Int                   @default(0)
  startedAt      DateTime              @default(now())
  completedAt    DateTime?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
  cohortId       String?
  cohort         Cohort?               @relation(fields: [cohortId], references: [id])
  course         Course                @relation(fields: [courseId], references: [id], onDelete: Cascade)
  student        User                  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  grades         Grade[]
  lessonProgress LessonProgress[]
  liveClasses    LiveClassEnrollment[]
  payments       Payment[]
  achievements   StudentAchievement[]
  activities     StudentActivity[]

  @@unique([studentId, courseId])
  @@index([studentId])
  @@index([courseId])
  @@index([cohortId])
  @@index([status])
}

model LessonProgress {
  id           String     @id @default(cuid())
  enrollmentId String
  lessonId     String
  completed    Boolean    @default(false)
  completedAt  DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  enrollment   Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  lesson       Lesson     @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([enrollmentId, lessonId])
  @@index([enrollmentId])
  @@index([lessonId])
  @@index([completed])
}

model Test {
  id          String        @id @default(cuid())
  courseId    String
  title       String
  description String?
  duration    Int?
  status      TestStatus    @default(DRAFT)
  publishedAt DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  questions   Question[]
  course      Course        @relation(fields: [courseId], references: [id], onDelete: Cascade)
  attempts    TestAttempt[]

  @@index([courseId])
  @@index([status])
}

model Question {
  id           String          @id @default(cuid())
  testId       String
  question     String
  type         QuestionType
  points       Int             @default(1)
  displayOrder Int             @default(0)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  options      AnswerOption[]
  test         Test            @relation(fields: [testId], references: [id], onDelete: Cascade)
  answers      StudentAnswer[]

  @@index([testId])
  @@index([displayOrder])
}

model AnswerOption {
  id           String   @id @default(cuid())
  questionId   String
  optionText   String
  isCorrect    Boolean  @default(false)
  displayOrder Int      @default(0)
  question     Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([questionId])
}

model TestAttempt {
  id          String          @id @default(cuid())
  testId      String
  studentId   String
  status      AttemptStatus   @default(IN_PROGRESS)
  score       Float?
  totalPoints Int?
  startedAt   DateTime        @default(now())
  submittedAt DateTime?
  answers     StudentAnswer[]
  student     User            @relation(fields: [studentId], references: [id], onDelete: Cascade)
  test        Test            @relation(fields: [testId], references: [id], onDelete: Cascade)

  @@index([testId])
  @@index([studentId])
  @@index([status])
}

model StudentAnswer {
  id               String      @id @default(cuid())
  attemptId        String
  questionId       String
  selectedOptionId String?
  answerText       String?
  isCorrect        Boolean?
  pointsAwarded    Float?
  attempt          TestAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  question         Question    @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([attemptId, questionId])
  @@index([attemptId])
  @@index([questionId])
}

model Announcement {
  id          String             @id @default(cuid())
  title       String
  content     String
  imageUrl    String?
  status      AnnouncementStatus @default(DRAFT)
  publishedAt DateTime?
  authorId    String?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  author      User?              @relation(fields: [authorId], references: [id])

  @@index([status])
  @@index([publishedAt])
}

model GalleryItem {
  id           String   @id @default(cuid())
  title        String
  description  String?
  imageUrl     String
  category     String?
  displayOrder Int      @default(0)
  isPublished  Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([category])
  @@index([isPublished])
  @@index([displayOrder])
}

model StudentProject {
  id           String                 @id @default(cuid())
  title        String
  slug         String                 @unique
  description  String
  imageUrl     String?
  studentName  String?
  courseName   String?
  technologies String?
  liveDemoUrl  String?
  githubUrl    String?
  isFeatured   Boolean                @default(false)
  isPublished  Boolean                @default(true)
  displayOrder Int                    @default(0)
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt
  records      StudentProjectRecord[]

  @@index([isFeatured])
  @@index([isPublished])
  @@index([displayOrder])
}

model BlogPost {
  id            String        @id @default(cuid())
  title         String
  slug          String        @unique
  excerpt       String?
  content       String
  coverImageUrl String?
  authorName    String?
  category      String?
  status        ContentStatus @default(DRAFT)
  publishedAt   DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([status])
  @@index([category])
  @@index([publishedAt])
}

model CorporateInquiry {
  id               String        @id @default(cuid())
  organization     String
  contactName      String
  email            String
  phone            String?
  organizationType String?
  trainingNeeds    String
  preferredFormat  String?
  message          String?
  status           InquiryStatus @default(NEW)
  adminNotes       String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@index([status])
  @@index([createdAt])
}

model Payment {
  id           String        @id @default(cuid())
  studentId    String
  enrollmentId String?
  amount       Float
  amountPaid   Float         @default(0)
  balance      Float         @default(0)
  status       PaymentStatus @default(PENDING)
  reference    String?       @unique
  method       PaymentMethod @default(MANUAL)
  notes        String?
  paidAt       DateTime?
  dueDate      DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  enrollment   Enrollment?   @relation(fields: [enrollmentId], references: [id])
  student      User          @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId])
  @@index([enrollmentId])
  @@index([status])
  @@index([createdAt])
}

model Cohort {
  id          String       @id @default(cuid())
  courseId    String
  name        String
  description String?
  startDate   DateTime?
  endDate     DateTime?
  status      CohortStatus @default(UPCOMING)
  createdById String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  course      Course       @relation(fields: [courseId], references: [id], onDelete: Cascade)
  createdBy   User?        @relation("CohortCreatedBy", fields: [createdById], references: [id])
  enrollments Enrollment[]

  @@index([courseId])
  @@index([status])
  @@index([startDate])
}

model LiveClass {
  id          String                @id @default(cuid())
  courseId    String
  createdById String?
  title       String
  description String?
  scheduledAt DateTime
  duration    Int?
  meetingUrl  String
  status      LiveClassStatus       @default(SCHEDULED)
  isPublished Boolean               @default(false)
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt
  attendance  Attendance[]
  course      Course                @relation(fields: [courseId], references: [id], onDelete: Cascade)
  createdBy   User?                 @relation("LiveClassCreatedBy", fields: [createdById], references: [id])
  students    LiveClassEnrollment[]

  @@index([courseId])
  @@index([scheduledAt])
  @@index([status])
  @@index([isPublished])
}

model LiveClassEnrollment {
  id           String     @id @default(cuid())
  liveClassId  String
  enrollmentId String
  createdAt    DateTime   @default(now())
  enrollment   Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  liveClass    LiveClass  @relation(fields: [liveClassId], references: [id], onDelete: Cascade)

  @@unique([liveClassId, enrollmentId])
  @@index([liveClassId])
  @@index([enrollmentId])
}

model Attendance {
  id          String           @id @default(cuid())
  liveClassId String
  studentId   String
  status      AttendanceStatus @default(ABSENT)
  joinedAt    DateTime?
  leftAt      DateTime?
  notes       String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  liveClass   LiveClass        @relation(fields: [liveClassId], references: [id], onDelete: Cascade)
  student     User             @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([liveClassId, studentId])
  @@index([liveClassId])
  @@index([studentId])
  @@index([status])
}

model Assessment {
  id          String           @id @default(cuid())
  courseId    String
  title       String
  description String?
  type        AssessmentType
  maxScore    Float            @default(100)
  dueDate     DateTime?
  status      AssessmentStatus @default(DRAFT)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  course      Course           @relation(fields: [courseId], references: [id], onDelete: Cascade)
  grades      Grade[]

  @@index([courseId])
  @@index([type])
  @@index([status])
}

model Grade {
  id           String      @id @default(cuid())
  studentId    String
  assessmentId String
  enrollmentId String?
  score        Float
  maxScore     Float
  grade        String?
  feedback     String?
  gradedById   String?
  gradedAt     DateTime    @default(now())
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  assessment   Assessment  @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  enrollment   Enrollment? @relation(fields: [enrollmentId], references: [id])
  gradedBy     User?       @relation("GradeGradedBy", fields: [gradedById], references: [id])
  student      User        @relation("GradeStudent", fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, assessmentId])
  @@index([studentId])
  @@index([assessmentId])
  @@index([enrollmentId])
}

model Achievement {
  id          String               @id @default(cuid())
  name        String               @unique
  description String?
  icon        String?
  points      Int                  @default(0)
  createdAt   DateTime             @default(now())
  students    StudentAchievement[]
}

model StudentAchievement {
  id            String      @id @default(cuid())
  studentId     String
  achievementId String
  enrollmentId  String?
  earnedAt      DateTime    @default(now())
  achievement   Achievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)
  enrollment    Enrollment? @relation(fields: [enrollmentId], references: [id])
  student       User        @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, achievementId])
  @@index([studentId])
  @@index([achievementId])
}

model StudentActivity {
  id           String       @id @default(cuid())
  studentId    String
  enrollmentId String?
  type         ActivityType
  title        String
  description  String?
  metadata     String?
  createdAt    DateTime     @default(now())
  enrollment   Enrollment?  @relation(fields: [enrollmentId], references: [id])
  student      User         @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId])
  @@index([enrollmentId])
  @@index([type])
  @@index([createdAt])
}

model StudentProjectRecord {
  id          String          @id @default(cuid())
  studentId   String
  projectId   String?
  title       String
  description String?
  score       Float?
  feedback    String?
  status      ProjectStatus   @default(PENDING)
  submittedAt DateTime?
  gradedAt    DateTime?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  project     StudentProject? @relation(fields: [projectId], references: [id])
  student     User            @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId])
  @@index([projectId])
  @@index([status])
}

enum UserRole {
  ADMIN
  STUDENT
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum ApplicationStatus {
  PENDING
  APPROVED
  REJECTED
  CONTACTED
}

enum EnrollmentStatus {
  ACTIVE
  COMPLETED
  SUSPENDED
  DROPPED
}

enum CourseStatus {
  ACTIVE
  INACTIVE
  DRAFT
}

enum TestStatus {
  DRAFT
  PUBLISHED
  CLOSED
}

enum QuestionType {
  MULTIPLE_CHOICE
  TRUE_FALSE
}

enum AttemptStatus {
  IN_PROGRESS
  SUBMITTED
  GRADED
}

enum AnnouncementStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum ContentStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum InquiryStatus {
  NEW
  CONTACTED
  IN_PROGRESS
  COMPLETED
  CLOSED
}

enum PaymentStatus {
  PENDING
  PAID
  PARTIAL
  OVERDUE
  CANCELLED
}

enum PaymentMethod {
  MANUAL
  PAYSTACK
  FLUTTERWAVE
  BANK_TRANSFER
  CASH
}

enum CohortStatus {
  UPCOMING
  ACTIVE
  COMPLETED
  CANCELLED
}

enum LiveClassStatus {
  SCHEDULED
  LIVE
  COMPLETED
  CANCELLED
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
}

enum AssessmentType {
  TEST
  PROJECT
  ASSIGNMENT
  EXAM
  PRACTICAL
}

enum AssessmentStatus {
  DRAFT
  PUBLISHED
  CLOSED
}

enum ActivityType {
  LESSON_COMPLETED
  TEST_COMPLETED
  PROJECT_SUBMITTED
  LIVE_CLASS_ATTENDED
  ACHIEVEMENT_EARNED
  PAYMENT_MADE
  COURSE_ENROLLED
  LOGIN
}

enum ProjectStatus {
  PENDING
  SUBMITTED
  GRADED
  APPROVED
  REJECTED
}
