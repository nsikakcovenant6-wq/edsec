generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/**
 * =========================
 * ENUMS
 * =========================
 */

enum UserRole {
  ADMIN
  STUDENT
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum ApplicationStatus {
  PENDING
  APPROVED
  REJECTED
  CONTACTED
}

enum EnrollmentStatus {
  ACTIVE
  COMPLETED
  SUSPENDED
  DROPPED
}

enum CourseStatus {
  ACTIVE
  INACTIVE
  DRAFT
}

enum TestStatus {
  DRAFT
  PUBLISHED
  CLOSED
}

enum QuestionType {
  MULTIPLE_CHOICE
  TRUE_FALSE
}

enum AttemptStatus {
  IN_PROGRESS
  SUBMITTED
  GRADED
}

enum AnnouncementStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum ContentStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum InquiryStatus {
  NEW
  CONTACTED
  IN_PROGRESS
  COMPLETED
  CLOSED
}

/**
 * =========================
 * USERS
 * =========================
 */

model User {
  id           String     @id @default(cuid())
  email        String     @unique
  passwordHash String
  firstName    String
  lastName     String
  phone        String?
  avatarUrl    String?
  role         UserRole   @default(STUDENT)
  status       UserStatus @default(ACTIVE)

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  lastLoginAt DateTime?

  studentProfile StudentProfile?
  applications   Application[]
  enrollments    Enrollment[]
  attempts       TestAttempt[]
  announcements  Announcement[]
}

/**
 * =========================
 * STUDENT PROFILE
 * =========================
 */

model StudentProfile {
  id               String    @id @default(cuid())
  userId           String    @unique
  dateOfBirth      DateTime?
  educationalLevel String?
  address          String?
  emergencyContact String?
  emergencyPhone   String?
  studentNumber    String    @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/**
 * =========================
 * APPLICATIONS
 * =========================
 */

model Application {
  id                 String            @id @default(cuid())
  applicantId        String?
  fullName           String
  email              String
  phone              String
  dateOfBirth        DateTime?
  educationalLevel   String?
  courseId           String?
  preferredFormat    String?
  preferredStartDate DateTime?
  additionalInfo     String?
  status             ApplicationStatus @default(PENDING)
  adminNotes         String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  applicant User?   @relation(fields: [applicantId], references: [id], onDelete: SetNull)
  course    Course? @relation(fields: [courseId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([courseId])
  @@index([createdAt])
}

/**
 * =========================
 * COURSES
 * =========================
 */

model Course {
  id               String       @id @default(cuid())
  title            String
  slug             String       @unique
  shortDescription String
  description      String?
  imageUrl         String?
  duration         String?
  learningFormat   String?
  requirements     String?
  syllabus         String?
  status           CourseStatus @default(DRAFT)
  featured         Boolean      @default(false)
  displayOrder     Int          @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  applications Application[]
  enrollments  Enrollment[]
  modules      CourseModule[]
  tests        Test[]

  @@index([status])
  @@index([featured])
  @@index([displayOrder])
}

/**
 * =========================
 * COURSE MODULES
 * =========================
 */

model CourseModule {
  id           String  @id @default(cuid())
  courseId     String
  title        String
  description  String?
  displayOrder Int     @default(0)
  isPublished  Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@index([courseId])
  @@index([displayOrder])
}

/**
 * =========================
 * ENROLLMENTS
 * =========================
 */

model Enrollment {
  id          String           @id @default(cuid())
  studentId   String
  courseId    String
  status      EnrollmentStatus @default(ACTIVE)
  progress    Int              @default(0)
  startedAt   DateTime         @default(now())
  completedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  student User   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  course  Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([studentId, courseId])
  @@index([studentId])
  @@index([courseId])
  @@index([status])
}

/**
 * =========================
 * TESTS
 * =========================
 */

model Test {
  id          String     @id @default(cuid())
  courseId    String
  title       String
  description String?
  duration    Int?
  status      TestStatus @default(DRAFT)
  publishedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  course    Course        @relation(fields: [courseId], references: [id], onDelete: Cascade)
  questions Question[]
  attempts  TestAttempt[]

  @@index([courseId])
  @@index([status])
}

/**
 * =========================
 * QUESTIONS
 * =========================
 */

model Question {
  id           String       @id @default(cuid())
  testId       String
  question     String
  type         QuestionType
  points       Int          @default(1)
  displayOrder Int          @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  test    Test            @relation(fields: [testId], references: [id], onDelete: Cascade)
  options AnswerOption[]
  answers StudentAnswer[]

  @@index([testId])
  @@index([displayOrder])
}

/**
 * =========================
 * ANSWER OPTIONS
 * =========================
 */

model AnswerOption {
  id           String  @id @default(cuid())
  questionId   String
  optionText   String
  isCorrect    Boolean @default(false)
  displayOrder Int     @default(0)

  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([questionId])
}

/**
 * =========================
 * TEST ATTEMPTS
 * =========================
 */

model TestAttempt {
  id          String        @id @default(cuid())
  testId      String
  studentId   String
  status      AttemptStatus @default(IN_PROGRESS)
  score       Float?
  totalPoints Int?
  startedAt   DateTime      @default(now())
  submittedAt DateTime?

  test    Test            @relation(fields: [testId], references: [id], onDelete: Cascade)
  student User            @relation(fields: [studentId], references: [id], onDelete: Cascade)
  answers StudentAnswer[]

  @@index([testId])
  @@index([studentId])
  @@index([status])
}

/**
 * =========================
 * STUDENT ANSWERS
 * =========================
 */

model StudentAnswer {
  id               String   @id @default(cuid())
  attemptId        String
  questionId       String
  selectedOptionId String?
  answerText       String?
  isCorrect        Boolean?
  pointsAwarded    Float?

  attempt  TestAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  question Question    @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([attemptId, questionId])
  @@index([attemptId])
  @@index([questionId])
}

/**
 * =========================
 * ANNOUNCEMENTS
 * =========================
 */

model Announcement {
  id          String             @id @default(cuid())
  title       String
  content     String
  imageUrl    String?
  status      AnnouncementStatus @default(DRAFT)
  publishedAt DateTime?
  authorId    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  author User? @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([publishedAt])
}

/**
 * =========================
 * GALLERY
 * =========================
 */

model GalleryItem {
  id           String  @id @default(cuid())
  title        String
  description  String?
  imageUrl     String
  category     String?
  displayOrder Int     @default(0)
  isPublished  Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([category])
  @@index([isPublished])
  @@index([displayOrder])
}

/**
 * =========================
 * STUDENT PROJECTS
 * =========================
 */

model StudentProject {
  id           String  @id @default(cuid())
  title        String
  slug         String  @unique
  description  String
  imageUrl     String?
  studentName  String?
  courseName   String?
  technologies String?
  liveDemoUrl  String?
  githubUrl    String?
  isFeatured   Boolean @default(false)
  isPublished  Boolean @default(true)
  displayOrder Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isFeatured])
  @@index([isPublished])
  @@index([displayOrder])
}

/**
 * =========================
 * BLOG
 * =========================
 */

model BlogPost {
  id            String        @id @default(cuid())
  title         String
  slug          String        @unique
  excerpt       String?
  content       String
  coverImageUrl String?
  authorName    String?
  category      String?
  status        ContentStatus @default(DRAFT)
  publishedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([category])
  @@index([publishedAt])
}

/**
 * =========================
 * CORPORATE INQUIRIES
 * =========================
 */

model CorporateInquiry {
  id               String        @id @default(cuid())
  organization     String
  contactName      String
  email            String
  phone            String?
  organizationType String?
  trainingNeeds    String
  preferredFormat  String?
  message          String?
  status           InquiryStatus @default(NEW)
  adminNotes       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([createdAt])
}
